{
  "hooks": {
    "enabled": true,
    "timeoutMs": 5000,
    "events": {
      "SessionStart": [
        {
          "matcher": "startup|resume|clear|compact",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/dream/brief_hook.sh\"",
              "enabled": true,
              "statusMessage": "Compiling session brief from dream/ outputs",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "matcher": "(SR-NIS2-[0-9]+|SO-NIS2-[0-9]+|RULE-D-[0-9.]+|REQ-D-[0-9.]+|D-[0-9]+\\.[0-9]+|NIST-(CSF|PF))",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/kg-reminder.sh\"",
              "enabled": true,
              "statusMessage": "Checking graphify reminder cache",
              "timeout": 5
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/guard-protected-files.sh\"",
              "timeout": 5,
              "statusMessage": "PreToolUse guard"
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PROJECT_DIR}/.zcode/hooks/guard-bash.sh\"",
              "timeout": 5,
              "statusMessage": "PreToolUse guard"
            }
          ]
        }
      ]
    }
  }
}